{
	"expo": {
		"name": "PhotoBrain",
		"slug": "photobrain",
		"version": "0.2.0",
		"scheme": "photobrain",
		"icon": "./assets/icon.png",
		"orientation": "default",
		"userInterfaceStyle": "automatic",
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.photobrain.app"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#0066cc"
			},
			"package": "com.photobrain.app"
		},
		"web": {
			"bundler": "metro",
			"output": "single"
		},
		"plugins": [
			"expo-router",
			"expo-updates",
			"expo-image",
			"expo-status-bar",
			"expo-font",
			"expo-asset",
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "26.0"
					}
				}
			]
		],
		"updates": {
			"url": "https://u.expo.dev/5fcc4958-f697-46c6-9cfc-cd2ce0ac695c",
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0
		},
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "5fcc4958-f697-46c6-9cfc-cd2ce0ac695c"
			}
		}
	}
}
