# .easignore - paths relative to monorepo root
# EAS uploads the entire monorepo since mobile references workspace packages.
# Without this file, the archive is ~15+ GB. Target: <100 MB.

# Dependencies (EAS installs these during build)
node_modules/
bun.lockb

# Git
.git/

# Rust native module (not used in mobile, 3+ GB)
packages/image-processing/target/
packages/image-processing/*.node
packages/image-processing/dist/
packages/image-processing/.fastembed_cache/

# Photo library and thumbnails
temp-photos/
apps/api/thumbnails/
data/
processed/

# Database files
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# fastembed caches
.fastembed_cache/
apps/api/.fastembed_cache/

# Build artifacts from other apps
apps/api/dist/
apps/web/dist/
build/

# Turbo cache
.turbo/
.cache/
.nx/

# Local environment files
.env
.env.local
.envrc.local

# Claude / AI
.claude/

# Test screenshots and artifacts
test-results/
coverage/
.nyc_output/
test-*.ts
test-*.js

# IDE and OS
.vscode/
.idea/
.DS_Store

# Docker
Dockerfile
docker-compose*.yml

# Misc
*.log
logs/
*.tmp
temp/
