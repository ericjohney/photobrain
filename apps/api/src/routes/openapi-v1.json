{
	"openapi": "3.1.0",
	"info": {
		"title": "PhotoBrain Native API",
		"version": "1.0.0"
	},
	"paths": {
		"/api/v1/folders": {
			"get": {
				"operationId": "listFolders",
				"responses": {
					"200": {
						"description": "Folder tree",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FoldersResponse"
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/filter-options": {
			"get": {
				"operationId": "listFilterOptions",
				"parameters": [
					{
						"name": "folder",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Available filters",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FilterOptionsResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/photos": {
			"get": {
				"operationId": "listPhotos",
				"parameters": [
					{
						"name": "filterRaw",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["all", "raw", "standard"],
							"default": "all"
						}
					},
					{
						"name": "folder",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "camera",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "lens",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "iso",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "dateMonth",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
						}
					},
					{
						"name": "minRating",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 5
						}
					},
					{
						"name": "flag",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["pick", "reject", "unflagged"]
						}
					},
					{
						"name": "collectionId",
						"in": "query",
						"required": false,
						"description": "Only photos that are members of this collection",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "tag",
						"in": "query",
						"required": false,
						"description": "Only photos carrying this automatic tag slug",
						"schema": {
							"type": "string",
							"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
							"maxLength": 64
						}
					}
				],
				"responses": {
					"200": {
						"description": "All matching photos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PhotosResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/photos/{id}": {
			"get": {
				"operationId": "getPhoto",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"responses": {
					"200": {
						"description": "Photo detail",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Photo"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"description": "Photo not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								},
								"examples": {
									"photoNotFound": {
										"value": {
											"error": {
												"code": "PHOTO_NOT_FOUND",
												"message": "Photo not found"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			},
			"patch": {
				"operationId": "updatePhotoCuration",
				"description": "Sets the photo's star rating and/or pick/reject flag. `flag: null` clears the flag. Available regardless of the native scan mutation flag.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/PhotoCurationPatch"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Updated photo detail",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Photo"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"description": "Photo not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								},
								"examples": {
									"photoNotFound": {
										"value": {
											"error": {
												"code": "PHOTO_NOT_FOUND",
												"message": "Photo not found"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/photos/{id}/similar": {
			"get": {
				"operationId": "listSimilarPhotos",
				"description": "Photos nearest to the source photo by CLIP vector distance (L2), nearest first with ties ordered by ascending id. The source photo is excluded. Only completed vectors for the current model and committed thumbnail generation participate. Optional `minRating`, `flag`, and `collectionId` filters apply to candidates before ranking and the limit, never to the source. When the source photo has no usable vector, `indexed` is false and `photos` is empty.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100,
							"default": 30
						}
					},
					{
						"name": "minRating",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 5
						}
					},
					{
						"name": "flag",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["pick", "reject", "unflagged"]
						}
					},
					{
						"name": "collectionId",
						"in": "query",
						"required": false,
						"description": "Only photos that are members of this collection",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "tag",
						"in": "query",
						"required": false,
						"description": "Only photos carrying this automatic tag slug",
						"schema": {
							"type": "string",
							"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
							"maxLength": 64
						}
					}
				],
				"responses": {
					"200": {
						"description": "Ranked visually similar photos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SimilarPhotosResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"description": "Photo not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								},
								"examples": {
									"photoNotFound": {
										"value": {
											"error": {
												"code": "PHOTO_NOT_FOUND",
												"message": "Photo not found"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/photos/{id}/collections": {
			"get": {
				"operationId": "listPhotoCollections",
				"description": "IDs (ascending) of the collections containing the photo.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"responses": {
					"200": {
						"description": "Collection membership",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PhotoCollectionsResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"description": "Photo not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								},
								"examples": {
									"photoNotFound": {
										"value": {
											"error": {
												"code": "PHOTO_NOT_FOUND",
												"message": "Photo not found"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/photos/{id}/tags": {
			"get": {
				"operationId": "listPhotoTags",
				"description": "Automatic CLIP zero-shot tags (at most three) for the photo, highest score first with ties by tag. Empty until the photo's vector has been tagged.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"responses": {
					"200": {
						"description": "Photo tags",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PhotoTagsResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"description": "Photo not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								},
								"examples": {
									"photoNotFound": {
										"value": {
											"error": {
												"code": "PHOTO_NOT_FOUND",
												"message": "Photo not found"
											}
										}
									}
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/review/junk": {
			"get": {
				"operationId": "listJunkReview",
				"description": "Junk-review candidates: photos that are not dismissed, not flagged, and unrated (rating 0) with at least one reason. Ordered by photo id descending and keyset-paginated with `cursor` (exclusive photo id). `counts` covers every candidate regardless of `reason` and `cursor`.",
				"parameters": [
					{
						"name": "reason",
						"in": "query",
						"required": false,
						"description": "Only candidates with this reason",
						"schema": {
							"$ref": "#/components/schemas/JunkReason"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 500,
							"default": 200
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "`nextCursor` from the previous page",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"responses": {
					"200": {
						"description": "One page of candidates with reasons and counts",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/JunkReviewResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/review/junk/resolve": {
			"post": {
				"operationId": "resolveJunk",
				"description": "Rejects (flag = reject) or keeps (dismissed from review permanently) the listed photos. Unknown photo IDs are ignored.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ResolveJunkRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Photos written",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ResolveJunkResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/search": {
			"post": {
				"operationId": "searchPhotos",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SearchRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Ranked photo search results",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SearchResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/scans": {
			"post": {
				"operationId": "startScan",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/StartScanRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Scan start domain result",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/StartScanResponse"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					},
					"503": {
						"description": "Native scan mutations are disabled",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								},
								"examples": {
									"nativeScanDisabled": {
										"value": {
											"error": {
												"code": "NATIVE_SCAN_DISABLED",
												"message": "Native scan mutations are disabled"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/scans/active": {
			"get": {
				"operationId": "listActiveScans",
				"responses": {
					"200": {
						"description": "Active scans in deterministic recovery order",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ActiveScansResponse"
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/scans/{jobId}": {
			"get": {
				"operationId": "getScan",
				"parameters": [
					{
						"name": "jobId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Durable scan status or null when the UUID is unknown",
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"$ref": "#/components/schemas/Scan"
										},
										{
											"type": "null"
										}
									]
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/collections": {
			"get": {
				"operationId": "listCollections",
				"description": "All collections sorted case-insensitively by name.",
				"responses": {
					"200": {
						"description": "Collections",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CollectionsResponse"
								}
							}
						}
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			},
			"post": {
				"operationId": "createCollection",
				"description": "Creates a collection. The name is trimmed and must be unique case-insensitively. Optional `photoIds` are added immediately; unknown and duplicate IDs are ignored.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateCollectionRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created collection",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Collection"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"409": {
						"$ref": "#/components/responses/CollectionNameTaken"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/collections/{id}": {
			"patch": {
				"operationId": "renameCollection",
				"description": "Renames a collection. Changing only the letter case of its own name is allowed.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RenameCollectionRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Renamed collection",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Collection"
								}
							}
						}
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"$ref": "#/components/responses/CollectionNotFound"
					},
					"409": {
						"$ref": "#/components/responses/CollectionNameTaken"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			},
			"delete": {
				"operationId": "deleteCollection",
				"description": "Deletes the collection and its memberships. Photos are never deleted.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"responses": {
					"204": {
						"description": "Collection deleted"
					},
					"400": {
						"$ref": "#/components/responses/InvalidRequest"
					},
					"404": {
						"$ref": "#/components/responses/CollectionNotFound"
					},
					"500": {
						"$ref": "#/components/responses/InternalError"
					}
				}
			}
		},
		"/api/v1/collections/{id}/photos": {
			"post": {
				"operationId": "addCollectionPhotos",
				"description": "Adds photos to the collection. Existing members and unknown photo IDs are ignored; `added` counts new memberships.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
