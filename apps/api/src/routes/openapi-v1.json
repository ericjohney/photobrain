								"type": "null"
							}
						]
					},
					"junkReasons": {
						"type": "array",
						"description": "Reasons in fixed order: screenshot, document, blurry, dark. Clients should ignore unknown values.",
						"items": {
							"$ref": "#/components/schemas/JunkReason"
						}
					}
				}
			},
			"JunkCounts": {
				"type": "object",
				"additionalProperties": false,
				"required": ["all", "screenshot", "document", "blurry", "dark"],
				"properties": {
					"all": {
						"type": "integer",
						"minimum": 0
					},
					"screenshot": {
						"type": "integer",
						"minimum": 0
					},
					"document": {
						"type": "integer",
						"minimum": 0
					},
					"blurry": {
						"type": "integer",
						"minimum": 0
					},
					"dark": {
						"type": "integer",
						"minimum": 0
					}
				}
			},
			"JunkReviewResponse": {
				"type": "object",
				"additionalProperties": false,
				"required": ["photos", "nextCursor", "counts"],
				"properties": {
					"photos": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/JunkReviewPhoto"
						}
					},
					"nextCursor": {
						"type": ["integer", "null"],
						"minimum": 1,
						"description": "Pass as `cursor` for the next page; null on the last page"
					},
					"counts": {
						"$ref": "#/components/schemas/JunkCounts"
					}
				}
			},
			"ResolveJunkRequest": {
				"type": "object",
				"additionalProperties": false,
				"required": ["photoIds", "action"],
				"properties": {
					"photoIds": {
						"type": "array",
						"minItems": 1,
						"maxItems": 500,
						"items": {
							"type": "integer",
							"minimum": 1
						}
					},
					"action": {
						"type": "string",
						"enum": ["reject", "keep"],
						"description": "`reject` sets flag to reject; `keep` dismisses the photo from review permanently"
					}
				}
			},
			"ResolveJunkResponse": {
				"type": "object",
				"additionalProperties": false,
				"required": ["updated"],
				"properties": {
					"updated": {
						"type": "array",
						"description": "Existing photo IDs written, ascending; unknown IDs are ignored",
						"items": {
							"type": "integer",
							"minimum": 1
						}
					}
				}
			},
			"ErrorResponse": {
				"type": "object",
				"additionalProperties": false,
				"required": ["error"],
				"properties": {
					"error": {
						"type": "object",
						"additionalProperties": false,
						"required": ["code", "message"],
						"properties": {
							"code": {
								"type": "string"
							},
							"message": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"responses": {
			"InvalidRequest": {
				"description": "Invalid request",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						},
						"examples": {
							"invalidRequest": {
								"value": {
									"error": {
										"code": "INVALID_REQUEST",
										"message": "Request validation failed"
									}
								}
							}
						}
					}
				}
			},
			"InternalError": {
				"description": "Internal server error",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						},
						"examples": {
							"internalError": {
								"value": {
									"error": {
										"code": "INTERNAL_ERROR",
										"message": "The request could not be completed"
									}
								}
							}
						}
					}
				}
			},
			"CollectionNotFound": {
				"description": "Collection not found",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						},
						"examples": {
							"collectionNotFound": {
								"value": {
									"error": {
										"code": "COLLECTION_NOT_FOUND",
										"message": "Collection not found"
									}
								}
							}
						}
					}
				}
			},
			"CollectionNameTaken": {
				"description": "Collection name already in use",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						},
						"examples": {
							"collectionNameTaken": {
								"value": {
									"error": {
										"code": "COLLECTION_NAME_TAKEN",
										"message": "A collection with that name already exists"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
